{
  "name": "ghost-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:ait": "tsc --noEmit && VITE_ADS_ENABLED=true VITE_AD_GROUP_REVIVE=ait.v2.live.eb0eddbc0d6a40df VITE_AD_GROUP_BANNER=ait.v2.live.2dceb89f19a24e7b VITE_AD_GROUP_INTERSTITIAL=ait.v2.live.c38e2dccaf0b4948 vite build && ait build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:sfx": "node scripts/gen-sfx.mjs",
    "ait:dev": "VITE_ADS_ENABLED=true vite --host",
    "ait:sandbox": "bash scripts/ait-sandbox-dev.sh",
    "ait:build": "npm run build:ait",
    "ait:deploy": "ait deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.3",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.0.2",
    "@supabase/supabase-js": "^2.108.2",
    "phaser": "^3.90.0",
    "posthog-js": "^1.391.2"
  }
}
